{
  "name": "eurnyse-c2c-frontend-uniapp",
  "version": "0.1.0",
  "private": true,
  "description": "EURNYSE C2C H5 pages built with uni-app Vue 2",
  "scripts": {
    "postinstall": "patch-package",
    "audit:prod": "node scripts/audit-production.mjs",
    "build:h5": "node scripts/build-h5.mjs",
    "preview:h5": "npm run build:h5 && npm run serve:dist",
    "serve:dist": "node scripts/ensure-h5-dist.mjs && node -e \"console.log('\\n  H5 預覽: http://127.0.0.1:8094/ → 自動進入 /h5/\\n  請勿關閉此終端機；若瀏覽器顯示 ERR_CONNECTION_REFUSED 表示本伺服器未在執行。\\n')\" && serve -l 8094 dist/build -n",
    "smoke:main-nav": "node scripts/smoke-main-nav.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "vue": "2.6.14",
    "vue-i18n": "^8.28.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.29.0",
    "@dcloudio/uni-app": "2.0.2-4080720251210002",
    "@dcloudio/uni-cli-i18n": "2.0.2-4080720251210002",
    "@dcloudio/uni-cli-shared": "2.0.2-4080720251210002",
    "@dcloudio/uni-h5": "2.0.2-4080720251210002",
    "@dcloudio/uni-i18n": "2.0.2-4080720251210002",
    "@dcloudio/uni-migration": "2.0.2-4080720251210002",
    "@dcloudio/uni-template-compiler": "2.0.2-4080720251210002",
    "@dcloudio/vue-cli-plugin-uni": "2.0.2-4080720251210002",
    "@dcloudio/webpack-uni-pages-loader": "2.0.2-4080720251210002",
    "@playwright/test": "^1.51.1",
    "@vue/cli-plugin-babel": "^4.5.19",
    "@vue/cli-service": "^4.5.0",
    "autoprefixer": "^9.8.8",
    "babel-loader": "^8.4.1",
    "cache-loader": "^4.1.0",
    "copy-webpack-plugin": "^6.4.1",
    "cross-env": "^7.0.3",
    "css-loader": "^3.5.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^4.5.2",
    "mini-css-extract-plugin": "^0.12.0",
    "optimize-css-assets-webpack-plugin": "^5.0.8",
    "patch-package": "^8.0.1",
    "postcss-loader": "^3.0.0",
    "puppeteer": "^24.42.0",
    "sass": "^1.32.0",
    "sass-loader": "^10.0.0",
    "serve": "^14.2.6",
    "thread-loader": "^2.1.3",
    "url-loader": "^4.1.1",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "2.6.14",
    "webpack": "4.47.0"
  }
}
