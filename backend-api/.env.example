# EURNYSE_C2C backend server template
#
# This project is MySQL / MariaDB only.
# The backend reads DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD.
# Do not rename them to DB_DATABASE / DB_USERNAME.
#
# Current template uses 127.0.0.1 to simulate a same-machine Baota deployment.
# When moving to a real server, keep the keys the same and only replace the values.

# Database host. Same-machine deployment usually uses 127.0.0.1.
DB_HOST=127.0.0.1

# Database port. Default MySQL / MariaDB port.
DB_PORT=3306

# Database name reserved for this project.
DB_NAME=eurnyse_c2c

# Database username reserved for this project.
DB_USER=eurnyse_c2c

# Database password placeholder. Replace before formal deployment.
DB_PASSWORD=change_me

# Current local-origin placeholders.
# Formal deployment example:
# API_ALLOWED_ORIGINS=https://c2c.example.com,https://admin.example.com
API_ALLOWED_ORIGINS=http://127.0.0.1:8094,http://127.0.0.1:8095

# Public URLs written into initial system_configs on first boot.
# Use production domains before importing a fresh database on the server.
FRONTEND_BASE_URLS=["https://c2c.example.com/h5"]
API_PUBLIC_BASE_URL=https://api.example.com/api

# Allowed office IPs or CIDR ranges for admin access.
ADMIN_ALLOWED_IPS=

# Max upload size in bytes. 5242880 = 5 MB.
UPLOAD_MAX_BYTES=5242880

# Admin login rate limit settings.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_BLOCK_SECONDS=900

# Production safety switches.
# Keep false in production. Set true only for local/staging demo data.
APP_ENABLE_DEMO_SEED_USERS=false
# Optional demo password used only when APP_ENABLE_DEMO_SEED_USERS=true.
APP_DEMO_SEED_USER_PASSWORD=

# Keep false in production. Set true only for a controlled local/staging bootstrap.
APP_ENABLE_DEFAULT_ADMIN=false
# Optional first admin bootstrap credentials used only when APP_ENABLE_DEFAULT_ADMIN=true and admin_users is empty.
APP_DEFAULT_ADMIN_ACCOUNT=
APP_DEFAULT_ADMIN_PASSWORD=

# Keep false in production. Set true only for a controlled local/staging bootstrap.
APP_ENABLE_RUNTIME_SUPER_ADMIN=false
# Optional password used only when APP_ENABLE_RUNTIME_SUPER_ADMIN=true and admin666 does not exist.
APP_RUNTIME_SUPER_ADMIN_PASSWORD=

# Never enable in production; returns verification codes in API responses.
AUTH_DEBUG_VERIFICATION_CODE=false
